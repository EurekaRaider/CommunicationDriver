<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>disable</ImplicitUsings>
        <PackageId>CommunicationDriver</PackageId>
        <Version>0.1.2</Version>
        <Authors>CommunicationDriver contributors</Authors>
        <Description>Shared native asynchronous communication core for TCP, UDP, serial, SSH, ADB and CLI.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/EurekaRaider/CommunicationDriver</RepositoryUrl>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all"/>
    </ItemGroup>
    <ItemGroup Condition="'$(NativePackageRoot)' != ''">
        <None Include="$(NativePackageRoot)/runtimes/**/*" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)"/>
        <None Include="$(NativePackageRoot)/licenses/*" Pack="true" PackagePath="licenses/"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="../../../README.md" Pack="true" PackagePath="/"/>
        <None Include="../../../skills/communicationdriver/**/*" Pack="true" PackagePath="skills/communicationdriver/%(RecursiveDir)%(Filename)%(Extension)"/>
        <None Include="CommunicationDriver.targets" Pack="true" PackagePath="build/CommunicationDriver.targets"/>
        <None Include="CommunicationDriver.targets" Pack="true" PackagePath="buildTransitive/CommunicationDriver.targets"/>
    </ItemGroup>
</Project>
