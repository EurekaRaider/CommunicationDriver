<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DriverSourceRoot Condition="'$(DriverSourceRoot)' == ''">../../../bindings/dotnet/CommunicationDriver</DriverSourceRoot>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="$(DriverSourceRoot)/*.cs" Link="Driver/%(Filename)%(Extension)"/>
    </ItemGroup>
</Project>
